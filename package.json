{
  "name": "tax-search-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "golden:build": "node --conditions=react-server --import tsx scripts/golden/buildCases.ts",
    "golden:status": "tsx scripts/golden/status.ts",
    "golden:probe-nonlaw": "node --conditions=react-server --import tsx scripts/golden/probeNonlaw.ts",
    "golden:probe-law": "node --conditions=react-server --import tsx scripts/golden/probeLaw.ts",
    "golden:build-nonlaw": "node --conditions=react-server --import tsx scripts/golden/buildNonlawCases.ts",
    "golden:harvest": "node --env-file=.env.local --conditions=react-server --import tsx scripts/golden/harvestToSeeds.ts",
    "perf:p95": "node --env-file=.env.local --conditions=react-server --import tsx scripts/perf/measureP95.ts",
    "perf:variance": "node --env-file=.env.local --conditions=react-server --import tsx scripts/perf/measureVariance.ts",
    "perf:diagnose": "node --env-file=.env.local --conditions=react-server --import tsx scripts/perf/measureP95.ts 40 diagnose",
    "perf:single": "node --env-file=.env.local --conditions=react-server --import tsx scripts/perf/single.ts",
    "perf:single-diagnostics": "node --env-file=.env.local --conditions=react-server --import tsx scripts/perf/singleDiagnostics.ts",
    "perf:diagnose-search": "node --env-file=.env.local --conditions=react-server --import tsx scripts/perf/diagnoseSearch.ts",
    "collect:nonlaw": "node --env-file=.env.local --conditions=react-server --import tsx scripts/collectNonlaw.ts",
    "migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "citation:build": "node --env-file=.env.local --import tsx scripts/buildCitationEdges.ts",
    "overruled:extract": "node --import tsx scripts/extractOverruledCandidates.ts",
    "overruled:apply": "node --env-file=.env.local --import tsx scripts/applyOverruledReview.ts",
    "embed": "node --env-file=.env.local --conditions=react-server --import tsx scripts/embed.ts",
    "smoke:vector": "node --env-file=.env.local --conditions=react-server --import tsx scripts/smokeVector.ts",
    "convert:precedent": "tsx scripts/convertPrecedentMd.ts",
    "collect:tribunal": "node --env-file=.env.local --conditions=react-server --import tsx scripts/collectTribunal.ts",
    "collect:precedent": "node --env-file=.env.local --conditions=react-server --import tsx scripts/collectPrecedent.ts",
    "probe:precedent": "node --env-file=.env.local --conditions=react-server --import tsx scripts/precedentRelevanceProbe.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.64",
    "@ai-sdk/voyage": "^1.0.7",
    "@types/pg": "^8.20.0",
    "ai": "^6.0.182",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
