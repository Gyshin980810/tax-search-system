# =====================================================
# 세법 검색 시스템 환경변수 템플릿 (SSOT §4.1)
# 이 파일을 .env.local로 복사한 뒤 실제 값을 채우세요.
# ⚠️ 이 파일에는 절대 실제 키·비밀번호를 적지 마세요 (git에 커밋되는 공개 템플릿).
# ⚠️ .env.local 은 절대 git에 커밋하지 마세요.
# =====================================================

# ── 필수 ──────────────────────────────────────────────

# 국세법령정보시스템 API (Phase 1)
# 발급: https://www.law.go.kr/DRF/openapi.do
NATIONAL_TAX_API_KEY=your-national-tax-api-key

# OpenAI API (Phase 2 이후)
# 용도: GPT-4o-mini(쿼리 변환·답변 생성)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Voyage 임베딩 API (TAX-6B-15)
# 용도: voyage-4(1024차원) 의미 검색·판례/심판례 임베딩
# 발급: https://dashboard.voyageai.com/
VOYAGE_API_KEY=pa-your-voyage-api-key

# 베타 접근 게이트 (TAX-056)
# BETA_ACCESS_CODE: 베타 사용자에게 공유할 패스코드(영문+숫자 12자 이상 권장)
# SESSION_SECRET : 쿠키 서명용 비밀키(랜덤 32자 이상). 교체 시 기존 로그인 전부 무효화
BETA_ACCESS_CODE=change-me-beta-access-code
SESSION_SECRET=change-me-random-32-chars-or-more

# ── 선택 ──────────────────────────────────────────────

# 벡터 DB (Phase 4, TAX-026-B)
# 미설정 시 FallbackSearchPort 비활성화 → 직접 매칭만 동작
# Neon·Supabase·Vercel Postgres 연결 문자열 (postgresql://... 형식)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 지방세법령 API (Phase 6A, 현재 미사용 — 국세 API와 동일 엔드포인트 사용)
# LOCAL_TAX_API_KEY=
